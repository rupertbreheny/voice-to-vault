# ==============================================================================
# voice-to-vault Configuration
# Copy this file to config.env and adjust paths to your setup:
#   cp config.example.env config.env
# ==============================================================================

# 1. Obsidian Vault or Target Markdown Root Directory
# The root folder where your markdown notes live.
VAULT_DIR="$HOME/Documents/Obsidian/Main"

# 2. Audio Intake / Queue Directory
# Where incoming audio files are deposited to be transcribed. The Voice Memos
# sync is only one way to fill this folder — you can also drop recordings from
# any other source straight in here (see "Bring Your Own Audio" in the README).
# Accepted: .m4a, .mp3, .wav, .aac, .qta. Only the root is scanned.
AUDIO_INGESTION_DIR="$HOME/Documents/Audio/transcription"

# 3. Processed Audio Backup Directory (Outside Vault)
# Audio files are moved here after successful transcription.
# Keeping this outside your vault prevents vault bloat and preserves Obsidian Sync limits.
AUDIO_PROCESSED_DIR="$AUDIO_INGESTION_DIR/processed"

# 4. Apple Voice Memos System Recordings Directory (macOS)
# Standard location for Apple Voice Memos cloud-synced recordings.
VOICE_MEMOS_DIR="$HOME/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings"

# 5. Voice Memos File Formats to Sync
# Comma-separated extensions the sync script copies out of the Voice Memos
# container. Voice Memos does not only write .m4a: depending on the recording
# format your device is set to it also writes QuickTime audio (.qta), commonly
# seen with stereo / spatial capture. The skill converts .qta to .m4a on intake.
# Metadata files in the container (CloudRecordings.db, waveform caches) are
# ignored automatically — you do not need to exclude them here.
SYNC_EXTENSIONS="m4a,qta"

# 6. Spoken Trigger Words / Topic Folders
# Comma-separated list of recognized keywords. If a recording begins with one of
# these words, it routes to a folder of the same name (e.g. notes/{keyword}/).
TRIGGER_WORDS="idea,dream,todo,meeting,journal,note"

# 7. Optional: Sync Dreams to Daily Notes
# If set to true, transcripts starting with "dream" are also appended to the
# previous day's daily note under the '# dream' heading.
SYNC_DREAM_TO_DAILY=false
DAILY_NOTE_PATH_FORMAT="daily/%Y/%m/%Y-%m-%d.md"

# 8. Batch Processing Limit
# Maximum number of audio files to process in a single run.
BATCH_LIMIT=20
